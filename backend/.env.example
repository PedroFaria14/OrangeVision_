# Copie sua URL do painel Connect do Neon. Nunca publique credenciais.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/neondb?sslmode=require
SQLITE_PATH=./data/orangevision_local.db
API_KEY=SUBSTITUA_POR_CHAVE_ALEATORIA_FORTE
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SYNC_INTERVAL_SECONDS=30

# Logs visíveis no terminal e gravados em arquivo
LOG_LEVEL=INFO
LOG_FILE=./logs/orangevision.log

# IA opcional: desligada por padrão. Sem chave, segue funcionando.
AI_ENABLED=false
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash


DEVICE_ID=
CREDENTIAL_ID=
DEVICE_INGEST_CREDENTIAL=