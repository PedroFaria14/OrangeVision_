# Exclusivo do Pi. NÃO colocar DATABASE_URL, senha de usuário ou cookie do site.
DEVICE_ID=
WEB_API_BASE_URL=
DEVICE_INGEST_CREDENTIAL=
DEVICE_SQLITE_PATH=./data/device_pipeline.db

# Captura: preencher após confirmar câmera e medir resolução/calibração.
CAMERA_ADAPTER=
CAMERA_INDEX=0
CAMERA_WIDTH=0
CAMERA_HEIGHT=0
CALIBRATION_PATH=

# Somente desenvolvimento no próprio computador; nunca usar em rede pública/LAN.
ALLOW_INSECURE_LOCAL_API=false
