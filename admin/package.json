{
  "name": "orangevision-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3001",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:database": "node --import tsx --test tests/database.integration.ts",
    "test:database:docker": "node scripts/test-database.mjs",
    "test:e2e": "npm run build && node scripts/test-database.mjs --browser"
  },
  "dependencies": {
    "@prisma/studio-core": "0.34.1",
    "next": "16.4.5",
    "next-auth": "4.24.15",
    "nuqs": "2.10.2",
    "pg": "8.23.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.15",
    "@types/pg": "8.16.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
