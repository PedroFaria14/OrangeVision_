# Nunca use prefixos NEXT_PUBLIC_ para estes valores.
NEXTAUTH_URL=http://127.0.0.1:3001
# Gere localmente: openssl rand -base64 48
NEXTAUTH_SECRET=
# GitHub OAuth App exclusiva deste painel.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# ID NUMÉRICO da sua conta GitHub, não nome de usuário ou e-mail.
ADMIN_GITHUB_ID=
# Role PostgreSQL sem privilégios de escrita, propriedade ou administração.
STUDIO_DATABASE_URL=
