# Configurações públicas. Nunca inserir credenciais Neon ou tokens privilegiados.
VITE_API_BASE_URL=/api
# Mesmo domínio no navegador. O proxy Vite chama a API HTTPS abaixo.
API_PROXY_TARGET=https://orangevision.onrender.com
# Em produção, configurar reverse proxy /api/* para a API online antes do fallback SPA.
# Não colocar API_KEY, DATABASE_URL, senhas ou tokens em variáveis VITE_*.
VITE_API_ENABLED=true

# Frontend funcional, sem painel visual ou fontes personalizadas.
