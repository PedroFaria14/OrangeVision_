# Configuração do site e do servidor local. Variáveis VITE_* são públicas.
VITE_API_BASE_URL=/api
# Mesmo domínio no navegador. O proxy Vite chama a API HTTPS abaixo.
API_PROXY_TARGET=https://orangevision-rs9g.onrender.com
# Destino remoto do indicador e dos inicializadores, inclusive no modo local.
RENDER_API_ORIGIN=https://orangevision-rs9g.onrender.com
# Em produção, configurar reverse proxy /api/* para a API online antes do fallback SPA.
# Não colocar API_KEY, DATABASE_URL, senhas ou tokens em variáveis VITE_*.
VITE_API_ENABLED=true

# Opcional: imagem pública local para o painel do login. Sem ela, usa ilustração.
# VITE_AUTH_IMAGE_URL=/images/laranjas.webp

# Prisma em /admin/prisma. Variáveis PRIVADAS, sem prefixo VITE_.
# Em produção: NEXTAUTH_URL=https://orange-vision.vercel.app
# Em desenvolvimento: NEXTAUTH_URL=http://127.0.0.1:5173
NEXTAUTH_URL=
NEXTAUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ADMIN_GITHUB_ID=
# Conexão PostgreSQL com role exclusiva de leitura e TLS no Neon.
STUDIO_DATABASE_URL=
