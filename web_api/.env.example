# API ONLINE apenas. Copie para web_api/.env; nunca para Frontend/.env.
# WEB_DATABASE_URL tem prioridade; DATABASE_URL do ambiente também é aceita.
# Só em development, sem ambas, permite reaproveitar DATABASE_URL de backend/.env.
# Em produção/Render, configurar a conexão nas Environment Variables do serviço.
WEB_DATABASE_URL=postgresql://USUARIO:SENHA@HOST/neondb?sslmode=require
WEB_ENV=development
WEB_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# 8 horas. Em produção, WEB_ENV=production exige HTTPS e ativa cookie Secure.
WEB_SESSION_SECONDS=28800

# Opcional. Manter false até revisar/aplicar 002_inspection_sessions.sql.
WEB_INSPECTIONS_ENABLED=false
# Prazo da autorização local: 15 min a 24 h. Iniciar/trocar operador exige internet.
WEB_INSPECTION_LEASE_SECONDS=28800

# Cadastro pós-login (migration 006). Limite de equipamentos criados pela conta.
WEB_MAX_DEVICES_PER_USER=5
# Opcional: origem HTTPS direta da API para a configuração copiada ao Raspberry.
# Sem valor, a tela sugere a própria origem HTTPS do site (proxy /api).
WEB_DEVICE_API_BASE_URL=

# Duas avaliações (migration 008, após 007). Habilitar após configurar o worker.
# Na Web API, esta flag agenda capturas novas; não inicia o worker automaticamente.
WEB_GEMINI_ENABLED=false
# Somente no servidor/worker do Render. Nunca usar VITE_, frontend ou Raspberry.
GEMINI_API_KEY=
# Modelo multimodal configurável; conferir disponibilidade na conta antes de ativar.
GEMINI_MODEL=gemini-3.8-flash
# Timeout HTTP de cada tentativa (5–90 s); até 3 tentativas por job.
GEMINI_TIMEOUT_SECONDS=30
# Limites de tentativas externas por dia UTC, incluindo falhas/incertezas.
# São limites de chamadas, não um teto monetário. Acompanhar também a cobrança Google.
GEMINI_DAILY_LIMIT=50
GEMINI_USER_DAILY_LIMIT=10
# Worker dedicado, na raiz do projeto: python -m web_api.gemini_worker
# OU, sem serviço pago extra: worker como thread dentro da própria Web API.
# Exige também WEB_GEMINI_ENABLED=true e GEMINI_API_KEY neste mesmo serviço.
# Não ative junto com um Background Worker separado sem necessidade (ambos são seguros
# pela lease no banco, mas consomem a mesma cota).
WEB_GEMINI_INPROCESS=false
# Publicação automática da categoria (local do Pi + Gemini):
# - as duas com categoria: entra se concordarem; divergência fica para revisão no site;
# - uma sem categoria (falhou): vale a categoria da outra;
# - as duas sem categoria, ou decisão já registrada: revisão no site.
# Enquanto uma ainda está rodando, espera. Com true, o local não publica antes da regra.
# Exige sessão de origem válida; correções no site viram nova revisão.
WEB_GEMINI_AUTO_ADOPT=false
# true: toda captura do Pi pede avaliação Gemini. false: Gemini só quando alguém
# clicar em "Solicitar Gemini" na amostra (o local entra direto no gráfico).
WEB_GEMINI_AUTO_REQUEST=true
# Guia completo: Docs/Avaliacoes_Local_Gemini.md
