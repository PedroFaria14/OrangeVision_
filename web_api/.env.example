# API ONLINE apenas. Copie para web_api/.env; nunca para Frontend/.env.
# WEB_DATABASE_URL tem prioridade; DATABASE_URL do ambiente também é aceita.
# Só em development, sem ambas, permite reaproveitar DATABASE_URL de backend/.env.
# Em produção/Render, configurar a conexão nas Environment Variables do serviço.
WEB_DATABASE_URL=postgresql://USUARIO:SENHA@HOST/neondb?sslmode=require
WEB_ENV=development
WEB_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# 8 horas. Em produção, WEB_ENV=production exige HTTPS e ativa cookie Secure.
WEB_SESSION_SECONDS=28800

# Opcional. Manter false até revisar/aplicar 002_inspection_sessions.sql.
WEB_INSPECTIONS_ENABLED=false
# Prazo da autorização local: 15 min a 24 h. Iniciar/trocar operador exige internet.
WEB_INSPECTION_LEASE_SECONDS=28800
